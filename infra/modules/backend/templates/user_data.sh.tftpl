#!/bin/bash
# Rendered by Terraform templatefile(); runs once on first boot of every Ubuntu VM.
# Logs: /var/log/cloud-init-output.log
set -euxo pipefail
export HOME=/root

apt-get update
DEBIAN_FRONTEND=noninteractive apt-get install -y git nodejs npm ca-certificates

mkdir -p /opt/app

# Runtime configuration. The database password is not stored here; the app fetches
# it from Azure Key Vault at startup using managed identity.
cat > /etc/app.env <<'ENVFILE'
PORT=${app_port}
NODE_ENV=production
DB_HOST=${db_host}
DB_PORT=${db_port}
DB_NAME=${db_name}
DB_USER=${db_user}
AZURE_KEY_VAULT_URL=${key_vault_url}
DB_PASSWORD_SECRET_NAME=${secret_name}
ENVFILE
chmod 640 /etc/app.env
chown root:root /etc/app.env

# Placeholder API so the VM has something healthy to serve before you point
# backend_repo_url at your own code.
cat > /opt/app/fallback_server.js <<'FALLBACK'
${fallback_server}
FALLBACK

APP_DIR=/opt/app
START_CMD="/usr/bin/node /opt/app/fallback_server.js"

if [ -n "${repo_url}" ]; then
  git clone --depth 1 --branch "${repo_branch}" "${repo_url}" /opt/app/src
  APP_DIR="/opt/app/src/${repo_app_dir}"
  (cd "$APP_DIR" && npm install --omit=dev)
  START_CMD="/usr/bin/node /opt/app/src/${repo_app_dir}/server.js"
fi

chown -R ubuntu:ubuntu /opt/app

cat > /etc/systemd/system/app.service <<UNIT
[Unit]
Description=E-commerce backend
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
EnvironmentFile=/etc/app.env
WorkingDirectory=$APP_DIR
ExecStart=$START_CMD
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable --now app.service
